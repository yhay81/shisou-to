{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shisou-to",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "shisou-to.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["53 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shisou-to",
      "database_id": "aa80d360-ca54-426b-aec8-4bba969fbc17",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
